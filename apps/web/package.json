{
  "name": "@applo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "echo '\\n⚠️  pnpm start runs the PRODUCTION build (next start). Did you mean `pnpm dev`?\\n     If you really want production locally, run: pnpm start:prod-local\\n' && exit 1",
    "start:prod-local": "next start -p 3001",
    "lint": "eslint",
    "check:pdfjs": "node scripts/check-pdfjs-version.mjs",
    "check:seo": "node --experimental-strip-types --no-warnings scripts/check-seo-data.mjs",
    "cf:hide-local-env": "test ! -f .env || mv .env .env.bak",
    "cf:restore-local-env": "test ! -f .env.bak || mv .env.bak .env",
    "cf:build": "pnpm run check:pdfjs && pnpm run check:seo && pnpm run cf:hide-local-env && (NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://api.applo.ai/api/v1} NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY:-0x4AAAAAADEb1zo5z5Pb47Dz} OPEN_NEXT=true opennextjs-cloudflare build); status=$?; pnpm run cf:restore-local-env; exit $status",
    "cf:build:staging": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://api-staging.applo.ai/api/v1} pnpm run cf:build",
    "cf:preview": "pnpm run cf:build && OPEN_NEXT=true opennextjs-cloudflare preview",
    "cf:deploy": "pnpm run cf:build && OPEN_NEXT=true opennextjs-cloudflare deploy",
    "cf:deploy:staging": "pnpm run cf:build:staging && OPEN_NEXT=true opennextjs-cloudflare deploy -- --env staging",
    "cf:upload": "pnpm run cf:build && OPEN_NEXT=true opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@applo/shared": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.71.0",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/turndown": "^5.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.14",
    "gpt-tokenizer": "^3.4.0",
    "isomorphic-dompurify": "^3.23.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.11",
    "next": "^16.3.3",
    "next-intl": "^4.14.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.86.0",
    "react-pdf": "^10.5.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "turndown": "^7.2.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.20",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.127.0"
  }
}
