# ─────────────────────────────────────────────────────────────────────────────
# Applo API — local development environment template.
#
# Copy this file to `.env` and fill in real values:
#   cp apps/api/.env.example apps/api/.env
#
# Never commit `.env`. Staging & prod read their values from Fly Secrets,
# not from a committed file.
# ─────────────────────────────────────────────────────────────────────────────

# Node Environment
NODE_ENV=development
PORT=3000

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# Default: local Docker Postgres (`docker compose -f infra/docker-compose.yml up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartapply
# DIRECT_URL is only required when DATABASE_URL points at a transaction-mode
# pooler (Neon pgbouncer, Supabase Supavisor). Optional for plain Postgres.
# DIRECT_URL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64  (must be 64+ chars)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_64_OUTPUT_AT_LEAST_64_CHARACTERS_LONG
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_BASE64_64_OUTPUT_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_EXPIRES_IN=15m

# ─── Storage (disk | r2) ─────────────────────────────────────────────────────
STORAGE_DRIVER=disk
# Boot fails when NODE_ENV=production unless this is 'r2' (the 'disk' driver
# writes to ephemeral Fly volumes and loses files on every redeploy).
# R2 (used when STORAGE_DRIVER=r2). EU-jurisdiction bucket for GDPR.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=applo-dev
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# ─── Job Queue (in-memory | qstash) ──────────────────────────────────────────
JOBS_DRIVER=in-memory
# Boot fails when NODE_ENV=production unless this is 'qstash' (the 'in-memory'
# driver drops every queued job on machine restart).
# QStash needs a public webhook URL — use ngrok/cloudflared for local dev.
# QSTASH_URL=https://qstash-eu-central-1.upstash.io
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_WEBHOOK_URL=

# ─── Rate Limit Storage (memory | upstash) ───────────────────────────────────
THROTTLER_STORAGE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── LLM Provider (mock | azure-openai | azure-ai-foundry | mistral | fake) ──
# Use 'azure-openai' when iterating on prompts; 'mock' for UI/auth work.
# 'fake' = deterministic, v1-chain-aware offline provider (eval/CI). Unlike
# 'mock' it satisfies the callJson steps, so the FULL generation chain runs with
# no network and no cost. It also forces the fast/mid lanes off — otherwise an
# "offline" run would still bill real side-lane calls.
LLM_PROVIDER=mock
LLM_TEMPERATURE_DEFAULT=0.5
LLM_MAX_TOKENS_DEFAULT=3000
LOG_LLM_CALLS=false
# Pseudonymous per-feature LLM token-usage tracking (issue #522). Salt for the
# keyed per-actor hash in `llm_usage_events` — generate with:
#   openssl rand -hex 32
# UNSET = usage tracking is OFF (no rows are written at all).
# LLM_USAGE_HASH_SALT=
# Retention (days) for llm_usage_events — a daily cron hard-deletes older rows
# (the table is pseudonymous personal data under GDPR; audit 2026-08-13 F11).
# 0 disables the sweep (not recommended).
LLM_USAGE_RETENTION_DAYS=90
# Retention (days) for uploaded originals (POST /uploads) that never became a
# JobPosting — a daily cron deletes unreferenced objects older than this so an
# abandoned résumé doesn't linger in object storage (Art. 5(1)(e) DSGVO).
# 0 disables the sweep.
UPLOAD_RETENTION_DAYS=7
# Retention (days) for application_email_events — sender, sender name and
# subject of inbox mail that drove an automatic status change. A daily cron
# hard-deletes older rows (Art. 5(1)(e) DSGVO). 0 disables the sweep.
MAILBOX_EVENT_RETENTION_DAYS=180
# Optional cheaper model for the mechanical extraction steps (ats-keywords,
# job-facts, skill-selector) — writing steps stay on the provider's default
# model (per-task routing). Provider-agnostic: a Mistral model name (La
# Plateforme) or an Azure deployment name. Unset = every task uses the default
# model. LLM_FAST_PROVIDER hosts the fast model on a DIFFERENT provider (e.g.
# prose on azure-openai, extraction on Mistral La Plateforme — needs MISTRAL_*
# below); a fast-lane failure falls back to the main provider on its default
# model. Evaluated 2026-08-02 — docs/guides/LLM_MODEL_SELECTION.md.
# LLM_FAST_MODEL=mistral-small-latest
# LLM_FAST_PROVIDER=mistral
# Optional "mid" lane: an Azure deployment that is cheaper than the flagship but
# still has native strict json_schema support (e.g. gpt-5.4-mini / -staging /
# -local). Used for Free-tier Bewerbungs-Checks; PRO/PREMIUM stay on the
# flagship. Unset = no mid lane (every caller keeps the default model).
# The MID endpoint is the Azure resource ROOT — NOT a project-scoped URL
# (https://<res>.services.ai.azure.com/api/projects/<name>), which is the Agents
# SDK form and 404s on /openai/v1. Endpoint and key fall back to AZURE_OPENAI_*,
# so a mid model deployed in the main resource only needs LLM_MID_MODEL.
# LLM_MID_MODEL=gpt-5.4-mini-local
# AZURE_OPENAI_MID_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
# AZURE_OPENAI_MID_API_KEY=

# Azure OpenAI (used when LLM_PROVIDER=azure-openai)
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
# v1 Foundry API channel: preview (always-latest) | v1 (latest GA).
# AZURE_OPENAI_API_VERSION=preview
# Reasoning effort for GPT-5-family/o-series deployments (minimal | low | medium
# | high); ignored for classic models like gpt-4.1. 'minimal' behaves closest to
# a non-reasoning model — lowest latency and cost.
# AZURE_OPENAI_REASONING_EFFORT=minimal

# Mistral (used when LLM_PROVIDER=mistral)
# Direct La Plateforme: keep the default endpoint and leave MISTRAL_API_VERSION unset.
# Azure AI Foundry (Mistral sold by Azure, EU Data Zone): set MISTRAL_ENDPOINT to
# https://<resource>.services.ai.azure.com/models AND set MISTRAL_API_VERSION.
# MISTRAL_ENDPOINT=https://api.mistral.ai/v1
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_API_VERSION=

# Voice Interview (Azure OpenAI Realtime API via WebRTC) — Premium feature.
# VOICE_PROVIDER=mock (default → voice mode hidden) | azure-realtime.
# Realtime models are only in East US 2 and Sweden Central; use Sweden Central
# for EU/GDPR. Endpoint/key fall back to AZURE_OPENAI_* when unset.
# DEPLOYMENT is the Azure deployment name, not the model name — one per env:
# gpt-realtime-2.1-mini (prod) / -staging / -local.
# VOICE_PROVIDER=mock
# AZURE_OPENAI_REALTIME_ENDPOINT=
# AZURE_OPENAI_REALTIME_API_KEY=
# AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini-local
# AZURE_OPENAI_REALTIME_VOICE=alloy
# VOICE_INTERVIEW_MAX_SESSION_MINUTES=15
# Emergency GLOBAL clamp on monthly voice minutes — the per-user cap lives in
# TIER_LIMITS.voiceMinutesPerMonth (Free 0 / Pro 60 / Premium 120). -1 = off.
# VOICE_INTERVIEW_MINUTES_PER_MONTH=-1

# Azure AI Foundry (used when LLM_PROVIDER=azure-ai-foundry)
# AZURE_AI_FOUNDRY_API_KEY=
# PROJECT_ENDPOINT=
# ATS_AGENT_ID=
# CV_WRITER_AGENT_ID=
# CL_WRITER_AGENT_ID=

# Circuit breaker around the LLM provider
LLM_CIRCUIT_BREAKER_TIMEOUT=60000
LLM_CIRCUIT_BREAKER_ERROR_THRESHOLD=50
LLM_CIRCUIT_BREAKER_RESET_TIMEOUT=30000
LLM_CIRCUIT_BREAKER_ROLLING_COUNT_TIMEOUT=10000
LLM_CIRCUIT_BREAKER_ROLLING_COUNT_BUCKETS=10

# ─── Agent URL Parser (Playwright + Azure OpenAI) ────────────────────────────
ENABLE_AGENT_PARSER=true
AGENT_MAX_STEPS=10
AGENT_TIMEOUT=30000
# Idle window before the warm Chromium is evicted (ms). Digits only.
# Default 60000, clamped to [1000, 600000]; anything else falls back to default.
# Higher = faster back-to-back parses, more idle RAM (~150-250MB per browser).
AGENT_BROWSER_IDLE_MS=60000
# The parser launches Chromium WITH its sandbox and falls back to --no-sandbox
# (with a prominent warning) only when the kernel can't provide one. Set true
# to skip the doomed first attempt in environments known to lack unprivileged
# user namespaces (e.g. local Docker's default seccomp profile). Audit F13.
AGENT_CHROMIUM_NO_SANDBOX=false

# ─── PDF Generation ──────────────────────────────────────────────────────────
# Renderer is `@react-pdf/renderer` (TSX templates under src/pdf-v2/templates).
# Previews are produced by pdf-v2/preview-renderer.service.ts via
# pdfjs-dist + @napi-rs/canvas. No env tuning surface.

# ─── File Upload Limits ──────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_PROFILE_PHOTO_SIZE_MB=5

# ─── Security ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSP_REPORT_ONLY=false
ENABLE_CSRF=false
ENABLE_COMPRESSION=true
ENABLE_CRON_JOBS=false

# IMPORTANT: production requires ENABLE_CSRF=true.

# ─── Rate Limiting (relaxed for dev) ─────────────────────────────────────────
# Tracker = verified JWT subject (per user), else the proxy-derived req.ip.
# Client-suppliable headers (CF-Connecting-IP, X-Forwarded-For) are never
# trusted (audit 2026-08-13 F16).
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100000
RATE_LIMIT_AUTH_TTL=900
RATE_LIMIT_AUTH_MAX=15

# Compromised-password check against HIBP Pwned Passwords (k-anonymity range
# query; the password never leaves the server). Fail-open on outages. Disable
# only for air-gapped/offline development. Audit 2026-08-13 F10.
PWNED_PASSWORD_CHECK_ENABLED=true

# ─── Misc ────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
REQUEST_TIMEOUT_MS=30000

# Two-Factor Authentication. Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT

# ─── OAuth (optional — leave blank to disable that provider locally) ─────────
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Free sandbox sender works without verifying a domain.
# RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
APP_URL=http://localhost:3001

# Parent domain shared by frontend + API. When set, auth cookies are issued
# with `Domain=<value>` so they're treated as first-party for ALL subdomains
# — required to fix Chrome's tracking-protection silently dropping cookies
# between e.g. `staging.applo.ai` and `api-staging.applo.ai`.
# Leave UNSET locally so cookies stay host-only on `localhost`.
# Production examples:
#   COOKIE_DOMAIN=.applo.ai
# COOKIE_DOMAIN=

# ─── Production-only (DO NOT set locally) ────────────────────────────────────
# KEY_VAULT_URI=
# SENTRY_DSN=

# ─── Email Tracking (Premium) — OAuth Inbox Sync ─────────────────────────────
# AES-256-GCM key used to encrypt persisted OAuth refresh tokens in
# `mailbox_connections`. Generate with: openssl rand -hex 32
# When unset, the mailbox-sync module refuses to connect new mailboxes.
# MAILBOX_TOKEN_ENCRYPTION_KEY=

# Microsoft Entra ID app for the inbox sync. SEPARATE app from the social
# login one above — this one needs the `Mail.Read` + `offline_access`
# scopes (delegated permissions). Add a Web redirect URI of
# https://<api-host>/api/v1/mailbox-sync/microsoft/callback in the Azure
# portal. Tenant `common` accepts both work and personal accounts.
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT=common

# Where the user is sent after a successful OAuth round-trip.
# Defaults to APP_URL + '/settings?email_tracking=connected'.
# MS_GRAPH_POST_CONNECT_REDIRECT=

# Renew Graph subscriptions when they have less than this many minutes
# remaining. Default 360 (6h) — Graph caps subscription lifetime at ~70.5h.
# MAILBOX_SUBSCRIPTION_RENEWAL_MARGIN_MINUTES=360

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated allow-list of admin emails. When empty, every /admin/*
# endpoint returns 403. Case-insensitive.
# ADMIN_EMAILS=you@example.com,coworker@example.com

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Master switch. When false, /payments/config reports billing as off and every
# money-moving endpoint returns 503 — the app runs fine without Stripe.
# When true, ALL of the values below are required or the API refuses to boot.
PAYMENTS_ENABLED=false

# Secret key. sk_test_… for local/staging, sk_live_… only in prod (the env
# schema rejects a test key when NODE_ENV=production).
# STRIPE_SECRET_KEY=sk_test_...

# Signing secret for POST /api/v1/payments/webhook. Each endpoint in the
# Stripe dashboard has its own. For local development, run
#   stripe listen --forward-to localhost:3000/api/v1/payments/webhook
# and use the whsec_… it prints (it differs from the dashboard's).
# STRIPE_WEBHOOK_SECRET=whsec_...

# PRICE ids (price_…, NOT product ids prod_…). Create the products in the
# Stripe dashboard with prices INCLUSIVE of tax — German B2C prices must be
# displayed gross (§ 1 PAngV), and €9.95 is the gross figure the UI advertises.
#
# ⚠️ Checkout sends `automatic_tax: { enabled: true }`. Stripe Tax collects NOTHING
# until an active registration exists for the customer's jurisdiction
# (Dashboard → Tax → Locations). A missing registration is NOT an error — Stripe
# silently returns zero tax, so the deploy looks healthy while under-collecting,
# and completed transactions cannot be corrected retroactively. Registrations are
# per-environment: a sandbox registration does NOT carry over to live mode.
# Products also need a tax code (we use txcd_10105001, AIaaS – cloud, personal use).
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PREMIUM=price_...

# One-off credit packs (10 / 30 / 75 applications).
# STRIPE_PRICE_ADDON_SMALL=price_...
# STRIPE_PRICE_ADDON_MEDIUM=price_...
# STRIPE_PRICE_ADDON_LARGE=price_...

# Kleinunternehmerregelung (§ 19 UStG). TRUE is the safe default: a small
# business charges no VAT, so claiming "inkl. 19 % MwSt." would advertise a tax
# that is never collected or remitted.
#
# When true:  Stripe Tax is OFF, no USt-IdNr is collected, invoices carry the
#             § 19 notice, and /pricing shows "Kein Ausweis von Umsatzsteuer".
# When false: the automatic_tax warning above applies — verify Germany shows
#             "Collecting" under Dashboard → Tax → Locations BEFORE going live,
#             and add your USt-IdNr to the Impressum (§ 5 Abs. 1 Nr. 6 DDG).
#
# Flip this only when the Finanzamt has actually moved you to Regelbesteuerung.
PAYMENTS_SMALL_BUSINESS=true
